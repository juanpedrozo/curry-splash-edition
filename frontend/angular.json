{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "curry": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "curry",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "index": "src/index.html",
            "outputPath": "dist/curry",
            "assets": [{ "glob": "**/*", "input": "public" }],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "node_modules/bootstrap-icons/font/bootstrap-icons.min.css",
              "src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "800kB", "maximumError": "1.1MB" },
                { "type": "anyComponentStyle", "maximumWarning": "18kB", "maximumError": "24kB" }
              ],
              "outputHashing": "all"
            },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "proxyConfig": "proxy.conf.json" },
          "configurations": {
            "production": { "buildTarget": "curry:build:production" },
            "development": { "buildTarget": "curry:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
